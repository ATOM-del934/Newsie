{
  "name": "weeklypet-tray",
  "version": "1.0.0",
  "private": true,
  "description": "Newsie · Electron 托盘版桌宠：常驻托盘，每周日 20:00 准点投递",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "preview": "electron . --preview",
    "pack": "electron-packager . Newsie --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --icon=../assets/pet.ico --app-version=1.0.0 --ignore=node_modules --ignore=dist --extra-resource=../index.html --extra-resource=../assets --extra-resource=../issues"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.0"
  }
}
